# bank-app/tester/config.env
#
# The ONLY file you need to edit. Plain KEY=VALUE, one per line; lines starting with # are comments.
# Do not put a trailing comment after a value (a # inside a password is kept as part of the password).

# ── your local PostgreSQL 16 ────────────────────────────────────────────────
# How the Docker containers reach PostgreSQL on this PC. Leave as-is for a normal Docker Desktop setup.
PG_HOST=host.docker.internal
PG_PORT=5432

# A superuser (normally "postgres"). It is used to prepare the server, create the database, load the
# data, and it is the account the migrator reads the source with.
PG_USER=postgres
PG_PASSWORD=change-me

# The bank database that will be created and loaded.
PG_DATABASE=bank_db

# ── used by 01_prepare_pg16.ps1 only ────────────────────────────────────────
# Name of the PostgreSQL 16 Windows service (check services.msc), and optionally the data directory
# (leave PG_DATA_DIR empty to read it from the service).
PG_SERVICE=postgresql-x64-16
PG_DATA_DIR=
# Which addresses may connect (Docker containers arrive from a private address, not 127.0.0.1).
# 0.0.0.0/0 is simplest and fine on a personal test PC; narrow it if you prefer, e.g. 172.16.0.0/12
PG_ALLOW_CIDR=0.0.0.0/0

# ── data size ───────────────────────────────────────────────────────────────
# tiny    10,000 customers      ~100k transfers      ~0.5M rows total     minutes
# small   100,000 customers     ~1M transfers        ~4.7M rows total
# medium  1,000,000 customers   ~10M transfers       ~47M rows total      the 10M-row target (needs ~10 GB, roughly 30-60 min)
# custom  uses SEED_CUSTOMERS below (rows total are about 47 x customers)
SEED_PRESET=medium
SEED_CUSTOMERS=

# ── migration ───────────────────────────────────────────────────────────────
# Change decoder: pgoutput ships with PostgreSQL (use this on Windows). wal2json needs a separate install.
DECODER=pgoutput
